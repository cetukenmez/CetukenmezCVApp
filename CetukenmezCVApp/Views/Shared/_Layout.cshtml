@inject CvProfile Profile
@{
    var title = ViewData["Title"] as string;
    var pageTitle = string.IsNullOrEmpty(title) ? $"{Profile.Name} · {Profile.Title}" : $"{title} · {Profile.Name}";
    var description = ViewData["Description"] as string ?? Profile.Tagline;
    var year = DateTime.UtcNow.Year;
}
<!DOCTYPE html>
<html lang="en" data-theme="light" class="no-js">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@pageTitle</title>
    <meta name="description" content="@description" />
    <meta name="author" content="@Profile.Name" />
    <meta name="theme-color" content="#0b0f19" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6f7fb" media="(prefers-color-scheme: light)" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@description" />
    <meta property="og:url" content="@Profile.SiteUrl" />
    <meta property="og:image" content="@(Profile.SiteUrl)/images/profil.webp" />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href="@Profile.SiteUrl" />
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        (function () {
            try {
                var stored = localStorage.getItem('theme');
                var theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                document.documentElement.setAttribute("data-theme", theme);
                document.documentElement.classList.replace("no-js", "js");
            } catch (e) { }
        })();
    </script>
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <div class="bg-glow bg-glow-1" aria-hidden="true"></div>
    <div class="bg-glow bg-glow-2" aria-hidden="true"></div>
    <div class="scroll-progress" aria-hidden="true"></div>

    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
        <div class="container header-inner">
            <a class="brand" href="/">
                <span class="brand-mark">CE</span>
                <span class="brand-name">@Profile.Name</span>
            </a>
            <nav class="site-nav" id="site-nav" aria-label="Sections">
                <a href="#about">About</a>
                <a href="#skills">Skills</a>
                <a href="#experience">Experience</a>
                <a href="#education">Education</a>
                <a href="#projects">Projects</a>
                <a href="#achievements">Achievements</a>
                <a href="#references">References</a>
            </nav>
            <div class="header-actions">
                <button class="icon-btn" id="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
                    <i class="fa-solid fa-moon theme-icon-dark" aria-hidden="true"></i>
                    <i class="fa-solid fa-sun theme-icon-light" aria-hidden="true"></i>
                </button>
                <a class="btn btn-primary btn-sm d-none-mobile" href="/cv.pdf">
                    <i class="fa-solid fa-download" aria-hidden="true"></i> CV
                </a>
                <button class="icon-btn nav-toggle" id="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="site-nav">
                    <i class="fa-solid fa-bars" aria-hidden="true"></i>
                </button>
            </div>
        </div>
    </header>

    <main id="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <div class="footer-brand">
                <div class="footer-name">@Profile.Name</div>
                <div class="footer-title">@Profile.Title · @Profile.Location</div>
            </div>
            <ul class="social-list">
                @foreach (var social in Profile.Socials)
                {
                    <li><a href="@social.Url" target="_blank" rel="noopener noreferrer" aria-label="@social.Name" title="@social.Name"><i class="@social.Icon" aria-hidden="true"></i></a></li>
                }
                <li><a href="mailto:@Profile.Email" aria-label="Email" title="Email"><i class="fa-solid fa-envelope" aria-hidden="true"></i></a></li>
            </ul>
            <div class="footer-meta">
                <span>&copy; @year @Profile.Name</span>
            </div>
        </div>
    </footer>

    <button class="back-to-top" id="back-to-top" type="button" aria-label="Back to top">
        <i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
    </button>

    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
