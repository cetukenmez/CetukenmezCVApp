@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}

<section class="section error-section">
    <div class="container">
        <div class="card error-card">
            <span class="error-code text-gradient">@Model.StatusCode</span>
            <h1>@Model.Title</h1>
            <p>@Model.Message</p>
            <div class="hero-actions">
                <a class="btn btn-primary" href="/"><i class="fa-solid fa-house" aria-hidden="true"></i> Back to home</a>
            </div>
            @if (Model.RequestId is not null)
            {
                <p class="error-request">Request ID: <code>@Model.RequestId</code></p>
            }
        </div>
    </div>
</section>
